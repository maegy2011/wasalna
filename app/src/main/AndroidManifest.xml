<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 1: permissions declared only, NOT requested at runtime yet -->
    <!-- Phase 9-1: INTERNET + network state required by the free OSM tile engine. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Phase 10.9.x: gradual alarm vibration (normal permission, auto-granted). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Headphone-only alerts: improves Bluetooth profile-state accuracy on
         API 31+ (runtime-requested when enabling the toggle). Wired + A2DP
         detection via AudioManager.getDevices needs no permission, so a
         denial only degrades accuracy — the feature keeps working. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Phase 10.4.2.1: CPU Partial WakeLock so tracking survives screen-off sleep. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Background-survival watchdog (Oct 2026 fix): resume a mid-trip
         after reboot. Normal permission, auto-granted. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- DND bypass: declaring this is what makes the app APPEAR in the
         system "Do Not Disturb access" list. Without it the list never
         shows Wasalna? and the bypass grant cannot be given. The grant
         itself is still approved by the user in system Settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Phase 10.11: API 30+ package visibility for dynamic destination
         share — PackageManager queries + geo/navigation/ride intents.
         Only what's queried is declared; nothing else changes. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="m.uber.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ubercab" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand" />
        <package android:name="com.mapswithme.maps" />
        <package android:name="com.ubercab" />
        <package android:name="com.didiglobal.passenger" />
        <package android:name="com.didi.global" />
        <package android:name="com.didapassenger" />
        <package android:name="com.indriver.passenger" />
        <package android:name="sinet.startup.inDriver" />
        <package android:name="com.inDriver" />
    </queries>

    <application
        android:name=".WasalnaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_legacy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wasalna"
        tools:targetApi="34">
        <!-- Phase 8: AdMob test App ID (replace with real ID before release). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- 100% MapLibre — no Google Maps SDK key needed. -->
        <!-- Phase 5: background location engine (foreground service, location type). -->
        <service
            android:name=".data.service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Background-survival watchdog (Oct 2026 fix): restarts a saved
             trip after process death; BOOT_COMPLETED resumes post-reboot. -->
        <receiver
            android:name=".data.service.TripWatchdogReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.app.wasalna.action.TRIP_WATCHDOG" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Wasalna">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Phase 10.8.0d: glanceable widget (RemoteViews, home_screen). -->
        <receiver
            android:name=".widget.WasalnaWidgetProvider"
            android:exported="false"
            android:label="Wasalna Quick Trip">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wasalna_widget_info" />
        </receiver>
        <!-- Phase 10.8.0: FileProvider for crash-log + places-backup sharing (internal files only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Phase 10.10: watch-side dismissal receiver (Data Layer).
             WearableListenerService requires BIND_LISTENER to receive
             events; the deprecation (prefer live Capability/Message
             listeners) is acknowledged — migration is future work, the
             filter stays so dismissal keeps working. -->
        <service
            android:name=".data.wear.PhoneWatchDismissService"
            android:exported="false"
            tools:ignore="WearableBindListener">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER"
                    tools:ignore="WearableBindListener" />
            </intent-filter>
        </service>
        <!-- Phase 6: full-screen destination alarm (lock-screen visible). -->
        <activity
            android:name=".ui.screens.alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Wasalna.NoActionBar" />
    </application>
</manifest>
